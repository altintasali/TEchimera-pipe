#!/usr/bin/env python3
"""techimera-pipe -- CLI front-end for the TEchimera-pipe workflow.

Bootstrap commands for a STAR + RSeQC + chimera-detection analysis:

  init     scaffold input/config.yaml + input/samples.csv from the templates
  samples  generate input/samples.csv from a directory of fastq files
  run      (re)build the config + sample sheet from flags, then run snakemake

The workflow itself still reads the same two gitignored files
(input/config.yaml and input/samples.csv); this CLI just creates them and
launches snakemake. Errors are written to stderr and exit non-zero (1).
"""
import argparse
import csv
import os
import re
import shlex
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
WORKFLOW_DIR = os.path.dirname(HERE)
REPO_ROOT = os.path.dirname(WORKFLOW_DIR)
SNAKEFILE = os.path.join(WORKFLOW_DIR, "Snakefile")
VERSION_FILE = os.path.join(REPO_ROOT, "VERSION")
CONFIG_EXAMPLE = os.path.join(REPO_ROOT, "config", "config.example.yaml")
SAMPLES_EXAMPLE = os.path.join(REPO_ROOT, "config", "samples.example.csv")
DEFAULT_INPUT_DIR = os.path.join(REPO_ROOT, "input")
DEFAULT_CONFIG = os.path.join(DEFAULT_INPUT_DIR, "config.yaml")
DEFAULT_SHEET = os.path.join(DEFAULT_INPUT_DIR, "samples.csv")

FASTQ_SUFFIXES = (".fastq.gz", ".fq.gz", ".fastq", ".fq")

_READ_MARKER = re.compile(r"^[Rr]?[12]$")
_LANE = re.compile(r"^L\d{2,4}$")
_SAMPLE_ID = re.compile(r"^[Ss]\d+$")
_CHUNK = re.compile(r"^\d{3,}$")

CSV_HEADER = """\
# Sample sheet generated by techimera-pipe.
# Columns (order matters): sample,fastq_1,fastq_2,strandedness,condition
# Edit this file to set per-sample 'strandedness' (auto/forward/reverse/
# unstranded; blank = auto) and 'condition' (biological group label; blank =
# no differential analysis). Repeated sample names = lane/run merging
# (nf-core style), which is how lanes below are written.
"""


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(1, f"{self.prog}: error: {message}\n")


def _die(msg, code=1):
    print(f"techimera-pipe: error: {msg}", file=sys.stderr)
    sys.exit(code)


def _read_version():
    try:
        with open(VERSION_FILE) as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


try:
    import yaml
except ImportError:
    yaml = None


def _load_yaml(path):
    if yaml is None:
        _die("the Python 'yaml' package is required but not installed")
    with open(path) as fh:
        return yaml.safe_load(fh)


def _write_yaml(path, data):
    if yaml is None:
        _die("the Python 'yaml' package is required but not installed")
    with open(path, "w") as fh:
        yaml.safe_dump(data, fh, sort_keys=False)


def _resolve_input_dir(value):
    if value is None:
        return DEFAULT_INPUT_DIR
    if os.path.isabs(value):
        return value
    return os.path.join(REPO_ROOT, value)


def _parse_fastq_name(fname):
    """Return (sample, read, lane) for a fastq filename.

    read is 1, 2, or None (single-end/unmarked); lane is e.g. 'L001' or None.
    Tokens are stripped from the right: chunk (_001), lane (_L00N), read
    marker (_R1/_R2/_1/_2), and an nf-core sample id (_S1).
    """
    base = fname
    for suffix in FASTQ_SUFFIXES:
        if base.endswith(suffix):
            base = base[: -len(suffix)]
            break
    tokens = re.split(r"[._]", base)
    while tokens and _CHUNK.match(tokens[-1]):
        tokens.pop()
    read = None
    if tokens and _READ_MARKER.match(tokens[-1]):
        read = 1 if tokens.pop()[-1] == "1" else 2
    lane = None
    if tokens and _LANE.match(tokens[-1]):
        lane = tokens.pop()
    if tokens and _SAMPLE_ID.match(tokens[-1]):
        tokens.pop()
    sample = "_".join(tokens) if tokens else None
    return sample, read, lane


def _scan_fastqs(reads_dir):
    paths = sorted(
        os.path.join(root, f)
        for root, _dirs, files in os.walk(reads_dir)
        for f in files
        if f.endswith(FASTQ_SUFFIXES)
    )
    if not paths:
        _die(
            f"no .fastq[.gz]/.fq[.gz] files found under {reads_dir!r}"
        )
    return paths


def build_samplesheet(fastq_paths):
    """Turn a list of fastq paths into sample-sheet rows (dicts)."""
    grouped = {}
    for path in fastq_paths:
        sample, read, lane = _parse_fastq_name(os.path.basename(path))
        if not sample:
            _die(f"could not determine a sample name from: {path}")
        grouped.setdefault((sample, lane), []).append((read, path))

    rows = []
    for (sample, lane), entries in sorted(grouped.items()):
        r1 = sorted(p for r, p in entries if r == 1)
        r2 = sorted(p for r, p in entries if r == 2)
        unmarked = sorted(p for r, p in entries if r is None)
        if r2 and not r1:
            _die(
                f"sample '{sample}': found R2 fastq(s) with no matching R1: "
                f"{', '.join(r2)}"
            )
        if len(r1) > 1:
            _die(
                f"sample '{sample}': multiple R1 fastqs in the same lane; the "
                f"workflow allows one R1 per row, so concatenate the chunks into "
                f"one file or rename them with lane tokens (L001/L002):\n"
                + "\n".join(f"  - {p}" for p in r1)
            )
        if len(r2) > 1:
            _die(
                f"sample '{sample}': multiple R2 fastqs in the same lane; the "
                f"workflow allows one R2 per row, so concatenate the chunks into "
                f"one file or rename them with lane tokens (L001/L002):\n"
                + "\n".join(f"  - {p}" for p in r2)
            )
        if r1 and unmarked:
            _die(
                f"sample '{sample}': both paired (_R1/_R2) and unmarked fastqs "
                f"in the same lane are ambiguous; rename one group:\n"
                + "\n".join(f"  - {p}" for p in r1 + unmarked)
            )
        if r1:
            rows.append({"sample": sample, "fastq_1": r1[0],
                         "fastq_2": r2[0] if r2 else "",
                         "strandedness": "", "condition": ""})
        else:
            rows.extend({"sample": sample, "fastq_1": p, "fastq_2": "",
                         "strandedness": "", "condition": ""} for p in unmarked)

    for sample in {r["sample"] for r in rows}:
        paired = any(r["sample"] == sample and r["fastq_2"] for r in rows)
        single = any(r["sample"] == sample and not r["fastq_2"] for r in rows)
        if paired and single:
            _die(
                f"sample '{sample}' mixes paired-end and single-end lanes; "
                f"the workflow cannot merge those (nf-core style requires "
                f"one orientation per sample)"
            )
    rows.sort(key=lambda r: (r["sample"], r["fastq_1"], r["fastq_2"]))
    return rows


def _emit_csv(fh, rows):
    fh.write(CSV_HEADER)
    fh.write("sample,fastq_1,fastq_2,strandedness,condition\n")
    writer = csv.writer(fh, lineterminator="\n")
    for r in rows:
        writer.writerow([r["sample"], r["fastq_1"], r["fastq_2"],
                         r["strandedness"], r["condition"]])


def cmd_init(args):
    input_dir = _resolve_input_dir(args.input_dir)
    os.makedirs(input_dir, exist_ok=True)
    targets = [("config.yaml", CONFIG_EXAMPLE),
               ("samples.csv", SAMPLES_EXAMPLE)]
    existing = [os.path.join(input_dir, name) for name, _ in targets
                if os.path.exists(os.path.join(input_dir, name))]
    if existing and not args.force:
        _die(
            f"{', '.join(existing)} already exist(s); re-run with --force "
            f"to overwrite"
        )
    for name, src in targets:
        dst = os.path.join(input_dir, name)
        shutil.copyfile(src, dst)
        print(f"wrote {dst}")
    print(
        "\nEdit the two files above, then launch the run with:\n"
        "  python workflow/scripts/techimera-pipe run"
    )


def cmd_samples(args):
    reads_dir = os.path.abspath(args.reads)
    if not os.path.isdir(reads_dir):
        _die(f"reads directory does not exist: {reads_dir!r}")
    rows = build_samplesheet(_scan_fastqs(reads_dir))
    if args.dry_run:
        _emit_csv(sys.stdout, rows)
        return 0
    sheet = os.path.abspath(args.samplesheet) if args.samplesheet else DEFAULT_SHEET
    if os.path.exists(sheet) and not args.force:
        _die(f"{sheet} already exists; re-run with --force to overwrite")
    os.makedirs(os.path.dirname(sheet), exist_ok=True)
    with open(sheet, "w") as fh:
        _emit_csv(fh, rows)
    print(f"wrote {sheet} ({len(rows)} sample row(s)) from {reads_dir}")


def _write_run_config(config_path, sheet_path, fasta, gtf, te_gtf):
    missing = [flag for flag, val in
               (("--fasta", fasta), ("--gtf", gtf), ("--te-gtf", te_gtf))
               if not val]
    if missing:
        _die(
            f"{config_path} does not exist; pass {' '.join(missing)} "
            f"(plus the rest) to generate it, or create the file yourself "
            f"(see config/config.example.yaml)"
        )
    conf = _load_yaml(CONFIG_EXAMPLE)
    conf["samples"] = sheet_path
    conf["ref"]["fasta"] = os.path.abspath(fasta)
    conf["ref"]["gtf"] = os.path.abspath(gtf)
    conf["ref"]["te_gtf"] = os.path.abspath(te_gtf)
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    _write_yaml(config_path, conf)
    print(
        f"wrote {config_path} from config/config.example.yaml "
        f"(samples + ref paths patched)"
    )


def cmd_run(args):
    if args.cores < 1:
        _die("--cores must be >= 1")
    config_path = os.path.abspath(args.config) if args.config else DEFAULT_CONFIG
    sheet_path = os.path.abspath(args.samplesheet) if args.samplesheet else DEFAULT_SHEET

    if args.reads:
        reads_dir = os.path.abspath(args.reads)
        if not os.path.isdir(reads_dir):
            _die(f"reads directory does not exist: {reads_dir!r}")

    if not os.path.exists(config_path) or args.force:
        _write_run_config(config_path, sheet_path,
                          args.fasta, args.gtf, args.te_gtf)
    elif args.fasta or args.gtf or args.te_gtf:
        print(f"note: {config_path} already exists; ignoring "
              f"--fasta/--gtf/--te-gtf", file=sys.stderr)

    if args.reads:
        if os.path.exists(sheet_path) and not args.force:
            _die(
                f"{sheet_path} already exists; re-run with --force to "
                f"regenerate it from {reads_dir}"
            )
        rows = build_samplesheet(_scan_fastqs(reads_dir))
        os.makedirs(os.path.dirname(sheet_path), exist_ok=True)
        with open(sheet_path, "w") as fh:
            _emit_csv(fh, rows)
        print(f"wrote {sheet_path} ({len(rows)} sample row(s)) from {reads_dir}")
    elif not os.path.exists(sheet_path):
        _die(
            f"no sample sheet at {sheet_path}. Generate one with:\n"
            f"  python workflow/scripts/techimera-pipe samples --reads DIR\n"
            f"or pass --reads to this command."
        )

    cmd = ["snakemake", "--configfile", config_path,
           "--cores", str(args.cores)]
    if args.profile:
        cmd += ["--profile", args.profile]
    if args.dry_run:
        cmd.append("-n")
    if args.keep_temp:
        cmd.append("--keep-temp")
    if args.snakemake_args:
        cmd += shlex.split(args.snakemake_args)
    if args.verbose:
        cmd += ["--printshellcmds", "--verbose"]

    print("dry-run (no jobs will run): " + " ".join(cmd)
          if args.dry_run else "running snakemake ...")
    try:
        proc = subprocess.run(cmd, cwd=REPO_ROOT)
    except FileNotFoundError:
        _die(
            "'snakemake' not found on PATH; activate the environment first:\n"
            "  source workflow/scripts/activate-env.sh"
        )
    if proc.returncode != 0:
        _die(
            f"snakemake failed (exit code {proc.returncode}); see the logs "
            f"under results/pipeline_info"
        )
    if args.dry_run:
        print("dry-run OK: the workflow parsed the config and planned all jobs")
    return 0


def _build_parser():
    parser = _Parser(
        prog="techimera-pipe",
        description=__doc__.strip().splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--version", action="version",
        version=f"%(prog)s {_read_version()}",
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)

    p_init = sub.add_parser(
        "init",
        help="scaffold input/config.yaml + input/samples.csv from the templates",
        description="Copy the committed .example templates into the (gitignored) "
                    "input/ directory so you can edit them for a new analysis.",
    )
    p_init.add_argument(
        "--input-dir", metavar="DIR",
        help="directory for the input files (default: <repo>/input)",
    )
    p_init.add_argument(
        "--force", action="store_true",
        help="overwrite the input files if they already exist",
    )
    p_init.set_defaults(func=cmd_init)

    p_samples = sub.add_parser(
        "samples",
        help="generate the sample sheet from a directory of fastq files",
        description="Scan a directory (recursively) for fastq files and write a "
                    "schema-valid input/samples.csv. _R1/_R2 (or _1/_2) pairs are "
                    "matched (a lone _R1 file is written as single-end); unmarked "
                    "files become single-end rows; _L00N lanes and _001 chunks "
                    "produce repeated rows for the same sample (nf-core lane "
                    "merging).",
    )
    p_samples.add_argument(
        "--reads", required=True, metavar="DIR",
        help="directory to scan for fastq files (recursive)",
    )
    p_samples.add_argument(
        "--samplesheet", metavar="PATH",
        help="output CSV (default: <repo>/input/samples.csv)",
    )
    p_samples.add_argument(
        "--dry-run", action="store_true",
        help="print the sheet to stdout instead of writing it",
    )
    p_samples.add_argument(
        "--force", action="store_true",
        help="overwrite the sample sheet if it already exists",
    )
    p_samples.set_defaults(func=cmd_samples)

    p_run = sub.add_parser(
        "run",
        help="(re)build config + sample sheet from flags, then run snakemake",
        description="Scaffold input/config.yaml (from config.example.yaml) when "
                    "missing, generate the sample sheet from --reads when missing, "
                    "then launch snakemake. An existing config/sample sheet is used "
                    "as-is unless --force is given.",
    )
    p_run.add_argument("--fasta", metavar="PATH",
                       help="genome FASTA (for a new config)")
    p_run.add_argument("--gtf", metavar="PATH",
                       help="gene annotation GTF (for a new config)")
    p_run.add_argument("--te-gtf", metavar="PATH",
                       help="curated TE annotation GTF (for a new config)")
    p_run.add_argument("--reads", metavar="DIR",
                       help="fastq directory; generates the sample sheet if missing")
    p_run.add_argument("--config", metavar="PATH",
                       help="config file (default: <repo>/input/config.yaml)")
    p_run.add_argument("--samplesheet", metavar="PATH",
                       help="sample sheet path (default: <repo>/input/samples.csv)")
    p_run.add_argument("--cores", type=int, default=1, metavar="N",
                       help="snakemake --cores (default 1)")
    p_run.add_argument("--profile", metavar="P",
                       help="snakemake --profile, e.g. workflow/profiles/slurm")
    p_run.add_argument("--dry-run", action="store_true",
                       help="print the snakemake plan without running jobs")
    p_run.add_argument("--keep-temp", action="store_true",
                       help="keep temp() fastqs that snakemake would delete")
    p_run.add_argument("--force", action="store_true",
                       help="regenerate config/sample sheet even if they exist")
    p_run.add_argument("--snakemake-args", metavar="ARGS",
                       help="extra snakemake arguments, passed through verbatim (quoted)")
    p_run.add_argument("-v", "--verbose", action="store_true",
                       help="print snakemake's shell commands (--printshellcmds)")
    p_run.set_defaults(func=cmd_run)

    return parser


def main(argv=None):
    args = _build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
